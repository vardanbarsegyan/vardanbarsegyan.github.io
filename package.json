{
  "name": "vardanbarsegyan-website",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for Vardan Barsegyan's academic website",
  "repository": {
    "type": "git",
    "url": "https://github.com/vardanbarsegyan/vardanbarsegyan.github.io"
  },
  "keywords": [
    "jekyll",
    "theme",
    "minimal"
  ],
  "author": "Vardan Barsegyan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/vardanbarsegyan/vardanbarsegyan.github.io/issues"
  },
  "homepage": "https://www.vardanbarsegyan.com",
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "jquery": "^4.0.0"
  },
  "devDependencies": {
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "build:js": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "test:js": "node --check assets/js/main.min.js"
  }
}
